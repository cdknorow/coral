src/coral.egg-info/
coral-go/cmd/coral/.launch-count
*pycache*
dist/
build/
*coral-go/bin/
*.DS_Store
*.egg-info/
*.egg
site/
.venv/*
*gocache*
.claude/scheduled_tasks.lock
.claude/settings.local.json
coral-go/coral
coral-go/coral.exe
coral-go/coral-dev
coral-go/coral-prod
coral-go/coral-app
coral-go/coral-board
coral-go/coral-dropboxers
coral-go/coral-staging
coral-go/coral-stage
coral-go/launch-coral.exe
coral-go/coral-board.exe
coral-go/coral-hook-agentic-state
coral-go/coral-hook-message-check
coral-go/coral-hook-task-sync
coral-go/coral-tray
coral-go/agent.test
*.exe

# Runtime data (workflow runs, scripts, OAuth tokens)
coral-go/.coral/

# Test/dev artifacts
coral-go/cmd/coral/messageboard.db*
coral-go/cmd/coral/api_key
coral-go/cmd/coral/themes/
coral-go/internal/server/routes/board_state_claude-*.json
coral-go/new_theme.json

# Frontend bundle backup (created during build, restored after)
coral-go/pkg/frontend/static/_src/
coral-go/pkg/frontend/static/app.js.map

# Agent docs are synced from coral-go/agent_docs/ at build time
coral-go/pkg/frontend/static/agent_docs/*
!coral-go/pkg/frontend/static/agent_docs/.gitkeep

# Large video files (use GitHub Releases for distribution)
icons/history.mp4
icons/main_loop.mp4
*.pem
coral-go/Users*.coral/*


# Private session summaries, and the links to the private notes repository (tools/link-internal.sh)
.claude/task_summaries.md
.claude/task_summaries.local.md
.claude/skills
.claude/commands

# go build with no -o leaves the program in the package's own folder (coral-go/cmd/<name>/<name>[.exe]): never to be committed
/coral-go/cmd/*/*.exe
/coral-go/cmd/*/coral
/coral-go/cmd/*/coral-*
!/coral-go/cmd/*/coral-*.go
/coral-go/cmd/*/launch-coral
/coral-go/cmd/*/mock-agent
