# Preserve the upstream OpenSSL license bytes on Windows checkouts.
licenses/OPENSSL-LICENSE.txt -text
# Keep every shipped license and notice text byte for byte on Windows checkouts: the
# vendor and font texts are pinned in licenses/SHA256SUMS.vendor, and a CRLF checkout
# would fail installers/third-party-notices.sh.
licenses/** -text
THIRD_PARTY_NOTICES_MPL.md -text
# The notices scripts run under Git Bash on the Windows runner.
installers/third-party-notices.sh text eol=lf
tests/release/verify_notices.sh text eol=lf
tests/windows/windows_only_tests.sh text eol=lf
# Tests compare these byte for byte with text they generate ("\n" endings); a CRLF checkout (core.autocrlf=true,
# as on the Windows runners) failed them on Windows (pkg/tunnel's view_redaction census and route-query table).
*.golden text eol=lf
coral-go/pkg/tunnel/routes_query.go text eol=lf
coral-go/internal/auth/testdata/*.html text eol=lf
# The health check's adversarial fixture is checked byte for byte (TestAdversarialFixtureFileHasNoLiteralInvisibles): no CRLF on Windows checkouts (#4175).
coral-go/internal/teamhealth/testdata/** -text
# Terminal captures (screen text and raw PTY output) are read byte for byte. A Windows checkout turned their LF into
# CRLF, and a test's end-of-line match then never fired (the input-gate oracles at v1.4.94, the third CRLF incident
# after v1.4.87's docs and v1.4.89's git am). Every capture keeps its committed bytes on every platform.
*.ansi -text
*.raw -text
coral-go/internal/ptymanager/testdata/** -text
coral-go/internal/server/routes/testdata/auto_accept/** -text
# Captured CLI output (agy and pi model lists, an agy step's output), parsed as the CLI printed it.
coral-go/internal/agentmodels/testdata/** -text
coral-go/cmd/coral-hook-agentic-state/testdata/** -text
# The updater verifier's real release fixtures (a SHA256SUMS.txt and its Sigstore bundle) are byte-exact: a CRLF checkout on Windows breaks the signature (#5279).
coral-go/internal/updater/verify/testdata/** -text
# The embedded Sigstore trusted root is trust material: byte for byte on every checkout (a Windows CRLF copy differs from the tested copy in testdata, #5279).
coral-go/internal/updater/verify/trusted_root.json -text
