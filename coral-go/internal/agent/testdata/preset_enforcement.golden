# preset<TAB>agent<TAB>what the CLI enforces (go test ./internal/agent -run TestPresetEnforcementTable -update)
Lead Developer	claude	allow=Agent,Bash,Bash(git branch *),Bash(git commit *),Bash(git merge *),Bash(git push *),Bash(git rebase *),Edit,Glob,Grep,Read,Write deny=-
Lead Developer	codex	sandbox=workspace-write approval=never
Lead Developer	agy	mode=skip-permissions
